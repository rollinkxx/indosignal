{
  "name": "indosignal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "benchmark:backtest": "node --expose-gc --import tsx scripts/benchmark-backtest.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:restart-proof": "tsx scripts/db-restart-proof.ts",
    "db:forward-test-proof": "tsx scripts/forward-test-db-proof.ts",
    "db:multi-pair-proof": "tsx scripts/multi-pair-scan-db-proof.ts",
    "check:market-mocks": "node scripts/check-no-market-mocks.mjs",
    "check:handoff-update": "node scripts/check-handoff-update.mjs",
    "check:live": "node scripts/check-live-endpoints.mjs",
    "check:docker-security": "node scripts/check-docker-security.mjs",
    "audit:chain": "node scripts/audit-chain.mjs verify",
    "audit:db-integrity": "node scripts/db-integrity-audit.mjs",
    "audit:snapshot": "node scripts/audit-chain.mjs snapshot",
    "audit:snapshot:verify": "node scripts/audit-chain.mjs verify-snapshot"
  },
  "dependencies": {
    "decimal.js": "10.5.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/pg": "8.23.1",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "4.1.12"
  }
}
