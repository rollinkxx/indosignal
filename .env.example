# Runtime role: non-superuser, no DDL, only required SELECT/INSERT/UPDATE grants.
# Do not reuse a production administrator connection string here.
DATABASE_URL=
DATABASE_SSL=verify-full

# Migration role: DDL-capable, used only by scripts/migrate.mjs at deploy startup.
# Configure separately in production; if omitted, migration falls back to DATABASE_URL for local compatibility.
MIGRATION_DATABASE_URL=
MIGRATION_DATABASE_SSL=verify-full

# Trust exactly one proxy-overwritten address header only when the hosting edge strips client-supplied values.
# Supported: cf-connecting-ip, x-real-ip, x-client-ip. X-Forwarded-For is never trusted.
TRUSTED_PROXY_HEADER=

# Optional secret (32+ chars) required for the bounded internal history diagnostic endpoint.
ADMIN_DIAGNOSTIC_TOKEN=

# Optional HMAC key for audit snapshot exports; keep in secret manager and anchor snapshots externally.
AUDIT_SNAPSHOT_HMAC_KEY=
AUDIT_SNAPSHOT_OUT=

# Optional; only needed if enabling an authenticated Indodax WebSocket stream.
INDODAX_WS_TOKEN=
